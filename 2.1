#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>
#include <stdlib.h>   /* atof 用到 */

#define MAX_ITEMS 100
#define MAX_WORDS 8
#define WORD_LEN  64

/* ---------- 商品数据（平行数组，不用结构体） ---------- */
char   item_names[MAX_ITEMS][16];
char   item_codes[MAX_ITEMS][12];
double item_prices[MAX_ITEMS];
int    item_stock[MAX_ITEMS];
int    item_count = 0;

char admin_pass[64] = "admin123";   /* 初始密码，可自行修改 */

/* ---------- 读一行，去掉末尾换行，返回 0 表示输入结束 ---------- */
int read_line(char* buf, int size)
{
    if (fgets(buf, size, stdin) == NULL)
        return 0;
    int k = 0;
    while (buf[k] != '\0')
    {
        if (buf[k] == '\n' || buf[k] == '\r')
        {
            buf[k] = '\0';
            break;
        }
        k++;
    }
    return 1;
}

/* ---------- 把一行按空格切成多个词，返回词的个数 ---------- */
int split_words(const char* line, char words[][WORD_LEN], int max_words)
{
    int i = 0, n = 0;
    while (line[i] != '\0' && n < max_words)
    {
        while (line[i] == ' ' || line[i] == '\t')   /* 跳过空格 */
            i++;
        if (line[i] == '\0')
            break;

        int j = 0;
        while (line[i] != '\0' && line[i] != ' ' && line[i] != '\t' && j < WORD_LEN - 1)
        {
            words[n][j] = line[i];   /* 复制一个词 */
            j++;
            i++;
        }
        words[n][j] = '\0';
        n++;
    }
    return n;
}

/* ---------- 按条码查找，返回下标，找不到返回 -1 ---------- */
int find_item(const char* code)
{
    for (int i = 0; i < item_count; i++)
    {
        if (strcmp(item_codes[i], code) == 0)
            return i;
    }
    return -1;
}

/* ---------- 打印价目表（包括价格、库存） ---------- */
void print_prices(void)
{
    printf("Item     No.  Pri. Stk.\n");
    printf("-----------------------\n");
    for (int i = 0; i < item_count; i++)
        printf("%-8s %s %.2f %d\n",
            item_names[i], item_codes[i], item_prices[i], item_stock[i]);
}

/* ---------- 主程序 ---------- */
int main(void)
{
    char line[256];
    char words[MAX_WORDS][WORD_LEN];
    char pw[64];
    int admin_mode = 0;      /* 0 = 收银员模式，1 = 管理员模式 */
    int running = 1;

    /* 初始商品 */
    strcpy(item_names[0], "Cola");      strcpy(item_codes[0], "001");
    item_prices[0] = 3.50; item_stock[0] = 10;
    strcpy(item_names[1], "Lollipop");  strcpy(item_codes[1], "002");
    item_prices[1] = 0.50; item_stock[1] = 10;
    strcpy(item_names[2], "Noodles");   strcpy(item_codes[2], "003");
    item_prices[2] = 6.00; item_stock[2] = 10;
    item_count = 3;

    while (running)
    {
        /* 根据模式显示不同提示符 */
        if (admin_mode)
            printf("admin> ");
        else
            printf("> ");
        fflush(stdout);

        if (read_line(line, sizeof(line)) == 0)
            break;                     /* Ctrl+Z 回车：结束输入，退出 */

        int n = split_words(line, words, MAX_WORDS);
        if (n == 0)
            continue;                  /* 空行 */

        char* cmd = words[0];

        /* quit / exit：两种模式下都可以直接退出程序 */
        if (strcmp(cmd, "quit") == 0 || strcmp(cmd, "exit") == 0)
        {
            running = 0;
            continue;
        }

        /* ================= 收银员模式 ================= */
        if (admin_mode == 0)
        {
            if (strcmp(cmd, "prices") == 0)
            {
                print_prices();
            }
            else if (strcmp(cmd, "admin") == 0)
            {
                printf("Password: ");
                fflush(stdout);
                if (read_line(pw, sizeof(pw)) == 0)
                {
                    running = 0;
                    continue;
                }
                if (strcmp(pw, admin_pass) == 0)
                {
                    admin_mode = 1;
                    printf("Admin mode.\n");
                }
                else
                {
                    printf("Wrong password.\n");
                }
            }
            else
            {
                /* 当作条码扫描 */
                int idx = find_item(cmd);
                if (idx >= 0)
                    printf("%-8s %.2f\n", item_names[idx], item_prices[idx]);
                else
                    printf("ERROR: code not found\n");
            }
        }
        /* ================= 管理员模式 ================= */
        else
        {
            if (strcmp(cmd, "back") == 0)
            {
                admin_mode = 0;
                printf("Bye.\n");
            }
            else if (strcmp(cmd, "prices") == 0)
            {
                print_prices();
            }
            else if (strcmp(cmd, "setprice") == 0)
            {
                if (n < 3)
                {
                    printf("Usage: setprice <code> <price>\n");
                    continue;
                }
                int idx = find_item(words[1]);
                if (idx < 0)
                    printf("ERROR: code not found\n");
                else
                {
                    item_prices[idx] = atof(words[2]);   /* 字符串转小数 */
                    printf("Price updated.\n");
                }
            }
            else if (strcmp(cmd, "itemadd") == 0)
            {
                if (n < 4)
                {
                    printf("Usage: itemadd <code> <name> <price>\n");
                    continue;
                }
                if (find_item(words[1]) >= 0)
                {
                    printf("ERROR: code already exists\n");
                    continue;
                }
                if (item_count >= MAX_ITEMS)
                {
                    printf("ERROR: item list is full\n");
                    continue;
                }
                strcpy(item_codes[item_count], words[1]);
                strcpy(item_names[item_count], words[2]);
                item_prices[item_count] = atof(words[3]);
                item_stock[item_count] = 0;              /* 新商品库存先记 0 */
                printf("%s(%s) added.\n",
                    item_names[item_count], item_codes[item_count]);
                item_count++;
            }
            else if (strcmp(cmd, "itemdel") == 0)
            {
                if (n < 2)
                {
                    printf("Usage: itemdel <code>\n");
                    continue;
                }
                int idx = find_item(words[1]);
                if (idx < 0)
                {
                    printf("ERROR: code not found\n");
                }
                else
                {
                    printf("%s(%s) removed.\n",
                        item_names[idx], item_codes[idx]);
                    /* 后面的元素整体往前挪一格 */
                    for (int i = idx; i < item_count - 1; i++)
                    {
                        strcpy(item_names[i], item_names[i + 1]);
                        strcpy(item_codes[i], item_codes[i + 1]);
                        item_prices[i] = item_prices[i + 1];
                        item_stock[i] = item_stock[i + 1];
                    }
                    item_count--;
                }
            }
            else
            {
                printf("ERROR: unknown command\n");
            }
        }
    }

    return 0;
}
