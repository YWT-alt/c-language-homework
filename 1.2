#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>

// 商品信息
char name[3][20] = { "Cola", "Lollipop", "Noodles" };
double price[3] = { 3.50, 0.50, 6.00 };
int count[3] = { 0, 0, 0 }; // 记录3个商品数量

// 打印小票函数
void printReceipt()
{
    printf("Receipt\n");
    printf("Item\tPri.\tQty\tAmount\n");
    printf("----------------------------\n");
    double total = 0;
    for (int i = 0; i < 3; i++)
    {
        if (count[i] > 0)
        {
            double amount = price[i] * count[i];
            printf("%s\t%.2f\t%d\t=%.2f\n", name[i], price[i], count[i], amount);
            total += amount;
        }
    }
    printf("----------------------------\n");
    printf("Total\t\t\t=%.2f\n\n", total);
}

int main()
{
    char cmd[20];
    printf("收银系统启动！输入条码/print/drop/checkout\n");
    while (1)
    {
        printf("> ");
        scanf("%s", cmd);

        // 结账
        if (strcmp(cmd, "checkout") == 0)
        {
            printReceipt();
            count[0] = count[1] = count[2] = 0;
        }
        // 打印小票
        else if (strcmp(cmd, "print") == 0)
        {
            printReceipt();
        }
        // 清空
        else if (strcmp(cmd, "drop") == 0)
        {
            count[0] = count[1] = count[2] = 0;
            printf("已清空购物车\n\n");
        }
        // 处理商品条码
        else
        {
            int id;
            int delta = 1;
            if (cmd[0] == '-')
            {
                delta = -1;
                sscanf(cmd, "-%d", &id);
            }
            else
            {
                sscanf(cmd, "%d", &id);
            }

            if (id == 1)
            {
                count[0] += delta;
                if (count[0] < 0) count[0] = 0;
                printf("%s\t%.2f x%d = %.2f\n\n", name[0], price[0], count[0], price[0] * count[0]);
            }
            else if (id == 2)
            {
                count[1] += delta;
                if (count[1] < 0) count[1] = 0;
                printf("%s\t%.2f x%d = %.2f\n\n", name[1], price[1], count[1], price[1] * count[1]);
            }
            else if (id == 3)
            {
                count[2] += delta;
                if (count[2] < 0) count[2] = 0;
                printf("%s\t%.2f x%d = %.2f\n\n", name[2], price[2], count[2], price[2] * count[2]);
            }
            else
            {
                printf("无效条码\n\n");
            }
        }
    }
    return 0;
}once;
