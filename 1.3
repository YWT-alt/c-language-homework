#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <string.h>
#include <time.h>

//商品基础信息
char name[3][20] = { "Cola", "Lollipop", "Noodles" };
double price[3] = { 3.50, 0.50, 6.00 };
int count[3] = { 0, 0, 0 };

int today = 1;          //当前是第几天
int serialNo = 1;       //当日交易流水号

//打印当前购物小票（内存里的商品）
void printCart()
{
    printf("Receipt\n");
    printf("Item\tPri.\tQty\tAmount\n");
    printf("----------------------------\n");
    double total = 0;
    for (int i = 0; i < 3; i++)
    {
        if (count[i] > 0)
        {
            double amount = price[i] * count[i];
            printf("%s\t%.2f\t%d\t=%.2f\n", name[i], price[i], count[i], amount);
            total += amount;
        }
    }
    printf("----------------------------\n");
    printf("Total\t\t\t=%.2f\n\n", total);
}

//把一次checkout的交易写入sales.txt
void saveRecord(int day, int no)
{
    FILE* fp = fopen("sales.txt", "a"); //追加写入
    if (fp == NULL)
    {
        printf("文件打开失败\n");
        return;
    }
    time_t now = time(NULL);
    struct tm* t = localtime(&now);
    char timeStr[20];
    strftime(timeStr, sizeof(timeStr), "%H:%M:%S", t);

    double total = 0;
    for (int i = 0; i < 3; i++)
    {
        if (count[i] > 0)
        {
            total += price[i] * count[i];
        }
    }
    //写入头部：日期，流水号，时间，总价
    fprintf(fp, "Day:%d No:%d Time:%s Total:%.2f\n", day, no, timeStr, total);
    //写入商品明细
    for (int i = 0; i < 3; i++)
    {
        if (count[i] > 0)
        {
            fprintf(fp, "  %s x%d\n", name[i], count[i]);
        }
    }
    fprintf(fp, "------------------------\n");
    fclose(fp);
}

//查询销售记录 sales [day]
void showSales(int targetDay)
{
    FILE* fp = fopen("sales.txt", "r");
    if (fp == NULL)
    {
        printf("暂无销售记录\n\n");
        return;
    }
    char line[256];
    double dailySum = 0;
    printf("Date: %d\n", targetDay);
    printf("No.\tTime\tItems\t\tAmount\n");
    printf("----------------------------------------\n");

    int readDay, readNo;
    char timeStr[20];
    double transTotal;
    while (fgets(line, sizeof(line), fp) != NULL)
    {
        if (sscanf(line, "Day:%d No:%d Time:%s Total:%lf", &readDay, &readNo, timeStr, &transTotal) == 4)
        {
            if (readDay == targetDay)
            {
                dailySum += transTotal;
                printf("%d\t%s", readNo, timeStr);
                //继续读商品行
                while (fgets(line, sizeof(line), fp) != NULL)
                {
                    if (strstr(line, "----")) break;
                    if (line[0] == ' ')
                    {
                        printf("  %s", line);
                    }
                }
                printf("\n");
            }
        }
    }
    printf("----------------------------------------\n");
    printf("Daily: %.2f\n\n", dailySum);
    fclose(fp);
}

int main()
{
    char cmd[30];
    printf("收银系统启动！支持指令：条码 / print / drop / checkout / newday / sales\n");
    while (1)
    {
        printf("> ");
        scanf("%s", cmd);

        if (strcmp(cmd, "checkout") == 0)
        {
            printCart();
            saveRecord(today, serialNo);
            serialNo++;
            count[0] = count[1] = count[2] = 0;
        }
        else if (strcmp(cmd, "print") == 0)
        {
            printCart();
        }
        else if (strcmp(cmd, "drop") == 0)
        {
            count[0] = count[1] = count[2] = 0;
            printf("已清空当前购物车\n\n");
        }
        else if (strcmp(cmd, "newday") == 0)
        {
            today++;
            serialNo = 1;
            count[0] = count[1] = count[2] = 0;
            printf("New day started. Today's sales records cleared.\n\n");
        }
        else if (strcmp(cmd, "sales") == 0)
        {
            showSales(today);
        }
        else
        {
            int id;
            int delta = 1;
            if (cmd[0] == '-')
            {
                delta = -1;
                sscanf(cmd, "-%d", &id);
            }
            else
            {
                sscanf(cmd, "%d", &id);
            }
            if (id == 1)
            {
                count[0] += delta;
                if (count[0] < 0) count[0] = 0;
                printf("%s\t%.2f x%d = %.2f\n\n", name[0], price[0], count[0], price[0] * count[0]);
            }
            else if (id == 2)
            {
                count[1] += delta;
                if (count[1] < 0) count[1] = 0;
                printf("%s\t%.2f x%d = %.2f\n\n", name[1], price[1], count[1], price[1] * count[1]);
            }
            else if (id == 3)
            {
                count[2] += delta;
                if (count[2] < 0) count[2] = 0;
                printf("%s\t%.2f x%d = %.2f\n\n", name[2], price[2], count[2], price[2] * count[2]);
            }
            else
            {
                printf("无效条码\n\n");
            }
        }
    }
    return 0;
}once;
